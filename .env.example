# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env lên git).
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows CMD)

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
PGHOST=localhost
# 08/2026 — trên Supabase, ƯU TIÊN dùng Transaction Pooler (port 6543)
# thay vì Session Pooler/Direct Connection (port 5432): transaction mode
# multiplex nhiều client ở tầng app xuống chung 1 số ít connection thật
# tới Postgres, tránh lỗi "EMAXCONNSESSION ... max clients reached in
# session mode" khi nhiều job nền + request API cùng mở connection (xem
# lịch sử trao đổi "lỗi 500 khi chạy nhiều script cùng lúc"). Lấy đúng
# connection string ở Supabase Dashboard -> Database -> Connection
# string -> "Transaction pooler". Đã rà soát code (08/2026): KHÔNG dùng
# LISTEN/NOTIFY, SET session-level, hay prepared statement giữ tên qua
# nhiều transaction -> an toàn 100% để chuyển sang transaction mode.
# Local dev / DB không qua Supabase pooler thì vẫn dùng 5432 như cũ.
PGPORT=6543
PGDATABASE=Student Success — Job Postings & Company Contacts
PGUSER=postgres
PGPASSWORD=
# Supabase / managed Postgres cloud thường bắt buộc SSL. Nếu chạy DB
# local không có SSL, đổi thành "disable".
PGSSLMODE=require

# ------------------------------------------------------------------
# enrich_company_web_info.py (script riêng, không bắt buộc cho pipeline
# crawl chính hay API layer)
# ------------------------------------------------------------------
TAVILY_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------
# API layer (api/app.py) — BẮT BUỘC nếu chạy uvicorn api.app:app
# ------------------------------------------------------------------

# Khóa dùng để gọi API — MỌI endpoint (kể cả /health) đều yêu cầu key
# này qua header 'X-API-Key'. Tự tạo 1 chuỗi ngẫu nhiên đủ dài, KHÔNG
# dùng giá trị đơn giản dễ đoán. Gợi ý tạo nhanh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Danh sách domain frontend ĐƯỢC PHÉP gọi API này từ trình duyệt (CORS),
# phân tách bằng dấu phẩy, KHÔNG có khoảng trắng thừa quanh dấu phẩy.
# Để trống -> không domain nào gọi được từ trình duyệt (an toàn mặc định).
# Ví dụ khi frontend deploy Vercel:
#   ALLOWED_ORIGINS=https://ss-dashboard.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# Bật Swagger UI (/docs), ReDoc (/redoc), /openapi.json — MẶC ĐỊNH TẮT
# (fail-closed), vì 3 route này KHÔNG bị chặn bởi API_KEY (giới hạn kỹ
# thuật của FastAPI, xem docstring api/app.py). Chỉ set "true" lúc dev
# local cần xem Swagger — KHÔNG bật trên môi trường public (Render) trừ
# khi đang debug tạm thời.
ENABLE_DOCS=

# Connection pool (db.init_pool(), gọi lúc api/app.py khởi động) — CHỈ
# dùng bởi API layer, không ảnh hưởng CLI main.py. Không set -> dùng
# mặc định min=2/max=20 (08/2026 — đã thử hạ xuống 8 lúc còn Session
# Pooler 5432 để né trần 15 connection của Supabase, nhưng 8 lại QUÁ
# THẤP cho tải polling thật, tự cạn pool nội bộ app -> nâng lại 20 SAU
# KHI đã chuyển hẳn sang Transaction Pooler, xem PGPORT ở trên; chi
# tiết đầy đủ ở config.py cạnh DB_POOL_MAX). Nếu LỠ đổi PGPORT về lại
# 5432 (Session Pooler/Direct), PHẢI hạ số này xuống lại (vd 8) để
# tránh tái phát lỗi EMAXCONNSESSION.
DB_POOL_MIN=2
DB_POOL_MAX=20

# 08/2026 — số giây tối đa get_pooled_connection() sẽ RETRY chờ pool có
# slot trống trước khi raise PoolError thật (xem db/connection.py) —
# hấp thụ burst polling thoáng qua (nhiều tab/job_type card cùng xin
# connection trong tích tắc) thay vì trả 500 ngay cho request tới chậm
# hơn 1 nhịp. Không set -> mặc định 2.0 giây.
DB_POOL_WAIT_TIMEOUT=2.0

# Số job nền (crawl + maintenance, xem api/concurrency.py) được phép
# chạy ĐỒNG THỜI trên toàn hệ thống — 08/2026, chặn việc bấm chạy nhiều
# loại job khác nhau cùng lúc (vd "Tra cứu web" + "Tìm Facebook" +
# "Vận hành dữ liệu") làm cạn connection Postgres. Mỗi job nền giữ 2
# connection NGOÀI pool (xem DB_POOL_MAX ở trên) trong suốt thời gian
# chạy -> KHÔNG set số này cao hơn mức DB_POOL_MAX + (GLOBAL_JOB_LIMIT *
# 2) vẫn nằm trong giới hạn connection thật của Postgres phía
# Render/Supabase. Không set -> mặc định 2.
GLOBAL_JOB_LIMIT=2

# ------------------------------------------------------------------
# Lớp đăng nhập TỪNG NGƯỜI (api/security.py) — BẮT BUỘC nếu dùng
# api/routers/auth.py (login/refresh/đổi mật khẩu/admin tạo user).
# KHÁC API_KEY ở trên (đó là 1 khoá dùng chung cho mọi client kiểu "máy
# gọi máy"; JWT_SECRET_KEY dưới đây dùng để KÝ token nhận diện TỪNG
# người dùng đã đăng nhập).
# ------------------------------------------------------------------

# Khoá ký JWT — PHẢI đủ dài/ngẫu nhiên, KHÁC với API_KEY ở trên (2 khoá
# riêng biệt, lộ 1 cái không kéo theo lộ cái kia). Gợi ý tạo nhanh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Đổi giá trị này SẼ làm mọi access/refresh token đang có hết hiệu lực
# ngay lập tức (mọi người phải đăng nhập lại) — dùng khi nghi khoá bị lộ.
JWT_SECRET_KEY=

# ------------------------------------------------------------------
# Đăng ký công khai + xác thực email (api/email_service.py,
# POST /auth/register) — thêm 08/2026, xem
# sql/migration_add_email_verification.sql. BẮT BUỘC nếu muốn luồng
# đăng ký công khai gửi được email thật (không set -> Resend báo lỗi
# thiếu API key, nhưng KHÔNG làm sập luồng đăng ký, xem docstring
# api/email_service.py send_verification_email()).
# ------------------------------------------------------------------

# Lấy tại https://resend.com/api-keys (miễn phí 3.000 email/tháng).
RESEND_API_KEY=

# Địa chỉ người gửi — MẶC ĐỊNH dùng domain test của Resend
# (onboarding@resend.dev), KHÔNG cần verify DNS gì, dùng được ngay.
# Đổi sang domain riêng (vd no-reply@ssteam.edu.vn) SAU KHI đã verify
# domain đó trong Resend (mục Domains) — xem lịch sử trao đổi.
EMAIL_FROM=onboarding@resend.dev

# Domain API THẬT đang chạy — dùng để dựng link xác thực trong email
# (vd https://scrap-jd-api.onrender.com/auth/verify-email?token=...).
# KHÔNG có dấu '/' cuối. Local dev thường là http://localhost:8000.
API_BASE_URL=http://localhost:8000

# Base URL của FRONTEND (mindx-jobs, deploy Vercel) — dùng cho link
# ĐẶT LẠI MẬT KHẨU trong email (khác API_BASE_URL ở trên, dùng cho link
# xác thực email trỏ về backend). KHÔNG có dấu '/' cuối.
# (vd https://mindx-jobs.vercel.app/reset-password?token=...)
FRONTEND_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------
# Supabase Storage — Lưu trữ file CV PDF (REST API)
# ------------------------------------------------------------------

# Project URL của Supabase (vd https://xxxxxxxxxxxx.supabase.co)
# Lấy tại Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (Secret key) — có quyền admin đầy đủ
# Lấy tại Supabase Dashboard → Settings → API → Project API Keys → service_role
# TUYỆT ĐỐI KHÔNG chia sẻ key này hay commit lên git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Tên bucket lưu file CV (mặc định: cv-files)
# Bucket này phải được tạo trước trên Supabase Storage với chế độ Private
SUPABASE_CV_BUCKET=cv-files
