# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.
#   cp .env.example .env      (macOS / Linux / Git Bash)
#   copy .env.example .env    (Windows CMD)
#
# Chỉ cần điền nhóm nào bạn dùng:
#   1. PostgreSQL        — BẮT BUỘC cho mọi thứ (crawl, migrate, API).
#   2. API layer         — chỉ khi chạy `uvicorn api.app:app` (trên Render đã cấu hình sẵn).
#   3. Email, Supabase   — chỉ khi dùng tính năng tương ứng của API.
#   4. Gemini / Tavily   — chỉ khi chạy các script enrich_*.
#   5. Tinh chỉnh crawl  — tuỳ chọn, mặc định đã ổn. Bỏ dấu # đầu dòng để đổi.
#
# Chỉ để chạy crawl trên máy (python main.py crawl ...) thì chỉ cần nhóm 1.

# ------------------------------------------------------------------
# 1. PostgreSQL (bắt buộc)
# ------------------------------------------------------------------
# Cách nhanh nhất để lấy đúng giá trị: mở Render -> service backend ->
# Environment, copy 5 biến PG* sang đây (backend đang dùng chính DB này).
# Hoặc lấy từ Supabase Dashboard -> Connect -> Transaction pooler.
#
# Supabase: nên dùng Transaction pooler (cổng 6543). Pooler cho nhiều client
# dùng chung một số ít connection thật, tránh lỗi "max clients reached in
# session mode" khi API và các job nền cùng mở connection. Code không dùng
# LISTEN/NOTIFY, SET theo phiên hay prepared statement giữ tên, nên chạy
# được trên transaction mode. Với Supabase, PGHOST dạng
# aws-0-<vùng>.pooler.supabase.com và PGUSER dạng postgres.<mã-project>.
# Postgres cài trên máy thì dùng cổng 5432.
PGHOST=localhost
PGPORT=6543
PGDATABASE=Student Success — Job Postings & Company Contacts
PGUSER=postgres
PGPASSWORD=
# Managed Postgres (Supabase...) bắt buộc SSL. DB local không có SSL thì
# đổi thành "disable".
PGSSLMODE=require

# ------------------------------------------------------------------
# 2. API layer (api/app.py) — bắt buộc khi chạy uvicorn api.app:app
# ------------------------------------------------------------------
# Khoá gọi API: mọi endpoint (kể cả /health) yêu cầu header X-API-Key khớp
# giá trị này. Tạo chuỗi ngẫu nhiên đủ dài:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Khoá ký JWT cho đăng nhập từng người. Phải ngẫu nhiên, đủ dài và KHÁC
# API_KEY. Tạo bằng cùng lệnh ở trên. Đổi giá trị này sẽ làm mọi token đang
# có hết hiệu lực (mọi người phải đăng nhập lại).
JWT_SECRET_KEY=

# Domain frontend được phép gọi API từ trình duyệt (CORS), cách nhau bằng
# dấu phẩy, không có khoảng trắng thừa. Để trống = không domain nào gọi
# được. Ví dụ:
#   ALLOWED_ORIGINS=https://mindx-jobs.vercel.app,http://localhost:5000
ALLOWED_ORIGINS=

# Bật Swagger UI (/docs), ReDoc (/redoc) và /openapi.json. Mặc định TẮT vì
# 3 route này không bị chặn bởi API_KEY. Chỉ đặt "true" khi dev local.
ENABLE_DOCS=

# Connection pool của API (không ảnh hưởng CLI main.py). Mặc định min 2,
# max 20 phù hợp với Transaction pooler. Nếu PGPORT là 5432 (Session pooler
# hoặc Direct connection) thì hạ DB_POOL_MAX xuống khoảng 8 để không vượt
# giới hạn connection của Supabase.
DB_POOL_MIN=2
DB_POOL_MAX=20

# Số giây tối đa chờ pool có slot trống trước khi báo lỗi pool đầy. Hấp thụ
# các đợt request dồn dập trong tích tắc.
DB_POOL_WAIT_TIMEOUT=2.0

# Số job nền (crawl + bảo trì dữ liệu) được chạy đồng thời trên toàn hệ
# thống. Mỗi job nền giữ 2 connection ngoài pool, nên giữ giá trị nhỏ.
GLOBAL_JOB_LIMIT=2

# ------------------------------------------------------------------
# 3. Email và lưu trữ file (tuỳ tính năng của API)
# ------------------------------------------------------------------
# Đăng ký công khai + quên mật khẩu (api/email_service.py). Thiếu
# RESEND_API_KEY thì email không gửi được nhưng luồng đăng ký không bị sập.
# Lấy key tại https://resend.com/api-keys (gói free 3.000 email/tháng).
RESEND_API_KEY=
# Người gửi. Mặc định dùng domain test của Resend, không cần verify DNS.
# Đổi sang domain riêng sau khi đã verify domain đó trong Resend.
EMAIL_FROM=onboarding@resend.dev
# Domain API thật, dùng dựng link xác thực email. Không có dấu "/" cuối.
API_BASE_URL=http://localhost:8000
# Domain frontend (mindx-jobs), dùng dựng link đặt lại mật khẩu. Không có
# dấu "/" cuối.
FRONTEND_BASE_URL=http://localhost:5000

# Supabase Storage lưu file CV PDF. Lấy ở Supabase Dashboard -> Settings
# -> API. SERVICE_ROLE_KEY có quyền admin đầy đủ: không chia sẻ, không
# commit lên git. Bucket phải tạo trước, chế độ Private.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_CV_BUCKET=cv-files

# ------------------------------------------------------------------
# 4. Script enrich_* (không bắt buộc cho crawl chính và API)
# ------------------------------------------------------------------
# Gemini: https://aistudio.google.com — cần cho enrich_company_profile_from_website.py
# và enrich_company_web_info.py.
GEMINI_API_KEY=
# Tavily: https://tavily.com (có gói free) — chỉ cần cho enrich_company_web_info.py.
TAVILY_API_KEY=

# ------------------------------------------------------------------
# 5. Tinh chỉnh crawl (tuỳ chọn — giá trị dưới đây là mặc định)
# ------------------------------------------------------------------
# Tốc độ TopCV: chờ DELAY giây cộng ngẫu nhiên +/- JITTER giây giữa hai
# request. Giảm số này để nhanh hơn thì dễ bị chặn hơn.
# TOPCV_REQUEST_DELAY_SECONDS=12.0
# TOPCV_REQUEST_JITTER_SECONDS=4.0

# Job đã có nhưng thiếu work_type / deadline / nội dung: chỉ fetch lại trang
# chi tiết nếu lần fetch thành công gần nhất đã cách đây từ ngần này ngày
# (hoặc chưa từng ghi nhận). Tin mà nguồn không ghi hạn nộp nhờ vậy không bị
# fetch lại ở mọi lượt. Sửa xong selector hỏng thì tối đa chừng này ngày sau
# job được vá. Đặt 0 để fetch lại ở mọi lượt crawl.
# DETAIL_RECHECK_DAYS=7

# Ngắt mạch: dừng cả lượt crawl khi N lần fetch thất bại LIÊN TIẾP (mỗi lần
# đã hết retry). Một request thành công đặt lại bộ đếm. 404/410 (tin đã gỡ)
# không tính. Đặt 0 để tắt. Lượt dừng vì lý do này có cờ stats.blocked.
# CRAWL_BLOCK_CONSECUTIVE_FAILURES=3

# Khi bắt đầu một lượt crawl, nếu cùng nguồn vừa bị chặn trong ngần này phút
# thì ghi cảnh báo vào log. Chỉ cảnh báo, không chặn chạy.
# CRAWL_BLOCK_COOLDOWN_MINUTES=60

# Lượt crawl bị đánh dấu degraded (stats.degraded) khi tỷ lệ bản ghi rỗng
# ở các field bắt buộc (job_title, company_name, job_description) đạt mức
# này trở lên (cần ít nhất 10 bản ghi), hoặc trang listing đầu parse ra
# 0 job. Dấu hiệu selector của site đã đổi. Khoảng 0.0 - 1.0.
# DEGRADED_EMPTY_RATE=0.9

# Snapshot HTML/JSON gốc để debug parser, lưu trong bảng crawl_snapshots
# (nén gzip). Mỗi lượt giữ tối đa SNAPSHOT_MAX_PER_RUN mẫu; đặt 0 để tắt.
# SNAPSHOT_MAX_PER_RUN=6
# Cắt nội dung dài hơn số ký tự này trước khi nén.
# SNAPSHOT_MAX_CHARS=1500000
# Snapshot cũ hơn số ngày này bị xoá mỗi lần có snapshot mới.
# SNAPSHOT_RETENTION_DAYS=14

# Watchdog: tự đánh dấu "error" cho lượt crawl bị treo để nguồn không bị
# khoá mãi. Lượt đang chạy bị coi là treo nếu không có tiến độ mới trong
# NO_PROGRESS phút; lượt đang xếp hàng (queued) bị coi là treo sau
# STALE_TIMEOUT phút; watchdog quét mỗi INTERVAL phút.
# CRAWL_STALE_NO_PROGRESS_MINUTES=30
# CRAWL_STALE_TIMEOUT_MINUTES=120
# CRAWL_WATCHDOG_INTERVAL_MINUTES=10
# Tương tự cho các job "Bảo trì dữ liệu".
# MAINTENANCE_STALE_TIMEOUT_MINUTES=180
# MAINTENANCE_WATCHDOG_INTERVAL_MINUTES=10

# Giới hạn kích thước body của request vào API (MB).
# MAX_REQUEST_BODY_MB=15
