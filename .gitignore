# Bí mật — TUYỆT ĐỐI không commit (chứa PGPASSWORD, API_KEY, TAVILY_API_KEY,
# GEMINI_API_KEY thật). .env.example (không có giá trị thật) vẫn commit
# bình thường, không nằm trong danh sách chặn này.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Log files (nếu sau này thêm logging ra file)
*.log

# File tiến độ kiểu cũ của scripts/backfill (nay tiến độ nằm trong bảng backfill_progress; giữ dòng này để file còn sót
# chờ --import-state-file không bị lỡ git add)
.backfill_vnw_detail.done
.backfill_topcv_level.done

# Kết quả đo coverage (pytest --cov)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Bộ nhớ đệm của mypy
.mypy_cache/

# Dữ liệu thật xuất ra từ DB/công cụ rà soát (có thể chứa tên công ty, người liên hệ, SĐT) — không commit.
# Fixture test cần CSV thì đặt tên rõ và dùng `git add -f` có chủ đích, kèm dữ liệu giả.
*.csv
*.xlsx
exports/
*.dump
*.sql.gz
